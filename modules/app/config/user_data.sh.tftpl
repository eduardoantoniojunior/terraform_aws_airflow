#!/bin/bash
set -e
exec > >(tee /var/log/user-data.log|logger -t user-data -s 2>/dev/console) 2>&1
echo "Iniciando user-data em $(date)"

echo "Atualizando o sistema..."
dnf update -y
dnf install vim -y
dnf install epel-release -y
dnf install htop -y

# ============================================
# Instalação do Docker
# ============================================
echo "Instalando o Docker CE..."
dnf remove -y docker docker-client docker-client-latest docker-common docker-latest \
  docker-latest-logrotate docker-logrotate docker-engine podman runc 2>/dev/null || true

dnf install -y dnf-plugins-core
dnf config-manager --add-repo https://download.docker.com/linux/rhel/docker-ce.repo
dnf install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker

sleep 5
systemctl is-active docker || { echo "ERRO: Docker não está ativo"; exit 1; }
echo "Docker está rodando."

docker compose version || { echo "ERRO: Docker Compose não está instalado"; exit 1; }
echo "Docker Compose está disponível."

usermod -aG docker rocky
echo "Instalação do Docker CE concluída."

# ============================================
# Configuração do Apache Airflow
# ============================================
echo "Preparando o Apache Airflow..."
AIRFLOW_HOME="/opt/airflow"
AIRFLOW_ADMIN_USERNAME='${airflow_admin_username}'
AIRFLOW_ADMIN_PASSWORD='${airflow_admin_password}'

mkdir -p $${AIRFLOW_HOME}/{dags,logs,plugins,config,data}

# ============================================
# Arquivo .env
# ============================================
echo "Criando arquivo .env..."
cat > $${AIRFLOW_HOME}/.env <<'ENVEOF'
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.8
AIRFLOW_PROJ_DIR=/opt/airflow
_AIRFLOW_WWW_USER_USERNAME=${airflow_admin_username}
_AIRFLOW_WWW_USER_PASSWORD=${airflow_admin_password}
ENVEOF

# ============================================
# docker-compose.yaml
# ============================================
echo "Criando docker-compose.yaml..."
cat > $${AIRFLOW_HOME}/docker-compose.yaml <<'COMPOSEEOF'
${docker_compose_content}
COMPOSEEOF

# ============================================
# Permissões
# ============================================
echo "Ajustando permissões dos diretórios..."
chown -R 50000:0 $${AIRFLOW_HOME}
chmod -R 775 $${AIRFLOW_HOME}

# ============================================
# Criação do serviço systemd para o Airflow
# ============================================
cat > /etc/systemd/system/airflow.service << EOF
[Unit]
Description=Apache Airflow Docker Compose
Requires=docker.service
After=docker.service
Wants=network-online.target
After=network-online.target

[Service]
User=root
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=$${AIRFLOW_HOME}
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose restart
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable airflow.service
systemctl start airflow.service

sleep 5
systemctl is-active airflow.service || { echo "ERRO: Serviço airflow não está ativo"; exit 1; }
echo "Serviço airflow iniciado (containers em 127.0.0.1:8080)."

# ============================================
# Instalação e configuração do Nginx
# ============================================
echo "Instalando Nginx..."
dnf install -y nginx
rm -f /etc/nginx/conf.d/default.conf

cat > /etc/nginx/conf.d/airflow.conf << EOF
server {
  listen 80;
  server_name _;

  location / {
    proxy_pass http://127.0.0.1:8080;

    proxy_set_header Host              \$host;
    proxy_set_header X-Real-IP         \$remote_addr;
    proxy_set_header X-Forwarded-For   \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;

    # WebSocket
    proxy_http_version 1.1;
    proxy_set_header Upgrade \$http_upgrade;
    proxy_set_header Connection "upgrade";

    proxy_read_timeout 90;
    proxy_connect_timeout 90;
    proxy_send_timeout 90;
  }
}
EOF

# --- SELinux: permitir Nginx proxyar para upstream ---
if command -v getenforce && [ "$(getenforce)" != "Disabled" ]; then
  setsebool -P httpd_can_network_connect 1
  setsebool -P httpd_can_network_relay 1 || true
  echo "Permissão SELinux ativada."
fi

nginx -t
systemctl enable nginx
systemctl restart nginx
echo "Nginx configurado com HTTP"

# ============================================
# Mensagem final
# ============================================
echo "=================================================="
echo "Apache Airflow está rodando!"
echo "Acesse: http://<IP_PUBLICO>/"
echo "Usuário: $${AIRFLOW_ADMIN_USERNAME}"
echo "Senha: $${AIRFLOW_ADMIN_PASSWORD}"
echo "=================================================="
echo "Deploy do Apache Airflow concluído em $(date)"
